{
    "Version":  "2012-10-17",
    "Statement":  [
                      {
                          "Effect":  "Allow",
                          "Resource":  "arn:aws:sqs:us-east-1:000000000000:skillbridge-resume-processing",
                          "Action":  [
                                         "sqs:ReceiveMessage",
                                         "sqs:DeleteMessage",
                                         "sqs:GetQueueAttributes",
                                         "sqs:ChangeMessageVisibility"
                                     ]
                      },
                      {
                          "Effect":  "Allow",
                          "Resource":  "*",
                          "Action":  [
                                         "logs:CreateLogGroup",
                                         "logs:CreateLogStream",
                                         "logs:PutLogEvents"
                                     ]
                      }
                  ]
}